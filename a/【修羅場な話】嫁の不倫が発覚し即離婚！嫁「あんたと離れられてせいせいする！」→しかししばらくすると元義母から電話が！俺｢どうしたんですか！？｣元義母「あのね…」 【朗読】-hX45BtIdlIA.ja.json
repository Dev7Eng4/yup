[
  {
    "rawStart": "00:00:01.400",
    "rawEnd": "00:00:03.790",
    "text": "もしかしたらそこまで復讐と言えるほど"
  },
  {
    "rawStart": "00:00:06.470",
    "rawEnd": "00:00:06.480",
    "text": "復讐ではないかもしれないけれど"
  },
  {
    "rawStart": "00:00:09.870",
    "rawEnd": "00:00:09.880",
    "text": "とりあえず書いていこうと思う個人的には"
  },
  {
    "rawStart": "00:00:14.070",
    "rawEnd": "00:00:14.080",
    "text": "すごくすっきりした話これは去年の7月の"
  },
  {
    "rawStart": "00:00:17.470",
    "rawEnd": "00:00:17.480",
    "text": "ことだったと思う幼馴染みである彼女と5"
  },
  {
    "rawStart": "00:00:22.189",
    "rawEnd": "00:00:22.199",
    "text": "年間交際をした後に結婚をし忙しくも充実"
  },
  {
    "rawStart": "00:00:25.670",
    "rawEnd": "00:00:25.680",
    "text": "した生活を送っていた2人ともまだ若かっ"
  },
  {
    "rawStart": "00:00:29.349",
    "rawEnd": "00:00:29.359",
    "text": "たこともあり初めは不安定だったが2年目"
  },
  {
    "rawStart": "00:00:33.510",
    "rawEnd": "00:00:33.520",
    "text": "くらいにはは生活も安定し出したそして"
  },
  {
    "rawStart": "00:00:37.389",
    "rawEnd": "00:00:37.399",
    "text": "結婚生活5年目になりそろそろ孫の顔が見"
  },
  {
    "rawStart": "00:00:40.709",
    "rawEnd": "00:00:40.719",
    "text": "たいと親にいびられ出した頃元夢の不倫が"
  },
  {
    "rawStart": "00:00:45.029",
    "rawEnd": "00:00:45.039",
    "text": "発覚した発覚した理由は離婚する1年前"
  },
  {
    "rawStart": "00:00:48.069",
    "rawEnd": "00:00:48.079",
    "text": "くらいから俺の口座に入っている残高が"
  },
  {
    "rawStart": "00:00:51.270",
    "rawEnd": "00:00:51.280",
    "text": "ごっそり減っていたことだった2人で生活"
  },
  {
    "rawStart": "00:00:54.549",
    "rawEnd": "00:00:54.559",
    "text": "費を管理するため通帳はいつも2人とも"
  },
  {
    "rawStart": "00:00:57.229",
    "rawEnd": "00:00:57.239",
    "text": "見れるように戸棚にしまっているのだが"
  },
  {
    "rawStart": "00:01:00.590",
    "rawEnd": "00:01:00.600",
    "text": "キャッシュレス決済をするために講座登録"
  },
  {
    "rawStart": "00:01:04.189",
    "rawEnd": "00:01:04.199",
    "text": "をしようと口座の残高を確認した時だった"
  },
  {
    "rawStart": "00:01:07.030",
    "rawEnd": "00:01:07.040",
    "text": "今まで稼いできたお金が綺麗になくなって"
  },
  {
    "rawStart": "00:01:10.950",
    "rawEnd": "00:01:10.960",
    "text": "いたのだ正確には残高がたったの300円"
  },
  {
    "rawStart": "00:01:14.469",
    "rawEnd": "00:01:14.479",
    "text": "しか残っていなかった初めは詐欺とか色々"
  },
  {
    "rawStart": "00:01:17.469",
    "rawEnd": "00:01:17.479",
    "text": "疑ったけれどどうやら自分で引き下ろして"
  },
  {
    "rawStart": "00:01:20.990",
    "rawEnd": "00:01:21.000",
    "text": "いるという履歴が残っていたそうなれば"
  },
  {
    "rawStart": "00:01:24.710",
    "rawEnd": "00:01:24.720",
    "text": "犯人は嫁しかいないので問い詰めると不倫"
  },
  {
    "rawStart": "00:01:27.630",
    "rawEnd": "00:01:27.640",
    "text": "していたことをあっさりと認めてきたどう"
  },
  {
    "rawStart": "00:01:30.830",
    "rawEnd": "00:01:30.840",
    "text": "やらその浮気相手に貢いでいた貯金を"
  },
  {
    "rawStart": "00:01:34.789",
    "rawEnd": "00:01:34.799",
    "text": "使い込んでいたらしいその浮気相手は無職"
  },
  {
    "rawStart": "00:01:37.550",
    "rawEnd": "00:01:37.560",
    "text": "らしく自分が見がないとダメになって"
  },
  {
    "rawStart": "00:01:40.350",
    "rawEnd": "00:01:40.360",
    "text": "しまうんだとか言っていた不倫していた"
  },
  {
    "rawStart": "00:01:43.429",
    "rawEnd": "00:01:43.439",
    "text": "ことにもひしこいて貯めていたお金も使わ"
  },
  {
    "rawStart": "00:01:46.550",
    "rawEnd": "00:01:46.560",
    "text": "れていたことにも呆れてしまった俺は即"
  },
  {
    "rawStart": "00:01:50.109",
    "rawEnd": "00:01:50.119",
    "text": "離婚をしたそのことに対して嫁も反論する"
  },
  {
    "rawStart": "00:01:53.590",
    "rawEnd": "00:01:53.600",
    "text": "ことなくあっさりと承諾し離婚届けに反抗"
  },
  {
    "rawStart": "00:01:57.429",
    "rawEnd": "00:01:57.439",
    "text": "を押す時にはあんたと離れられて生生する"
  },
  {
    "rawStart": "00:02:01.029",
    "rawEnd": "00:02:01.039",
    "text": "って解放感に満ち溢れた顔で行ってきた"
  },
  {
    "rawStart": "00:02:03.749",
    "rawEnd": "00:02:03.759",
    "text": "それからしばらくお互いに連絡を取ること"
  },
  {
    "rawStart": "00:02:07.109",
    "rawEnd": "00:02:07.119",
    "text": "もなく俺も1人での生活に慣れてきた頃"
  },
  {
    "rawStart": "00:02:10.749",
    "rawEnd": "00:02:10.759",
    "text": "だったなんと元義母から電話がかかってき"
  },
  {
    "rawStart": "00:02:14.150",
    "rawEnd": "00:02:14.160",
    "text": "たのだ幼馴染みだったということもあり"
  },
  {
    "rawStart": "00:02:17.350",
    "rawEnd": "00:02:17.360",
    "text": "向こうの親も自分の番号を知っていたので"
  },
  {
    "rawStart": "00:02:20.550",
    "rawEnd": "00:02:20.560",
    "text": "電話をかけてきたのだろう俺は出る気にも"
  },
  {
    "rawStart": "00:02:23.509",
    "rawEnd": "00:02:23.519",
    "text": "なれなかったのでしばらく無視を続けてい"
  },
  {
    "rawStart": "00:02:26.949",
    "rawEnd": "00:02:26.959",
    "text": "たのだがあまりにもしつこかったので1回"
  },
  {
    "rawStart": "00:02:30.550",
    "rawEnd": "00:02:30.560",
    "text": "だけ出ることにした少し気まずそうに"
  },
  {
    "rawStart": "00:02:35.670",
    "rawEnd": "00:02:35.680",
    "text": "もしもしと言ったどうしたんですかと話を"
  },
  {
    "rawStart": "00:02:39.190",
    "rawEnd": "00:02:39.200",
    "text": "聞くとどうやら元夢の不倫相手は既婚者"
  },
  {
    "rawStart": "00:02:42.949",
    "rawEnd": "00:02:42.959",
    "text": "だったらしく俺と別れた瞬間に速攻捨て"
  },
  {
    "rawStart": "00:02:46.990",
    "rawEnd": "00:02:47.000",
    "text": "られたと元木から聞いた元嫁はパートの"
  },
  {
    "rawStart": "00:02:50.030",
    "rawEnd": "00:02:50.040",
    "text": "仕事しかしていなかったので俺の稼ぎを"
  },
  {
    "rawStart": "00:02:53.350",
    "rawEnd": "00:02:53.360",
    "text": "全て貢いでいた時に比べたら貢ぐお金が"
  },
  {
    "rawStart": "00:02:57.070",
    "rawEnd": "00:02:57.080",
    "text": "少なくなったことと不倫相手の方は嫁と"
  },
  {
    "rawStart": "00:03:00.710",
    "rawEnd": "00:03:00.720",
    "text": "別れる気がなく不倫の関係のままでいられ"
  },
  {
    "rawStart": "00:03:03.110",
    "rawEnd": "00:03:03.120",
    "text": "ないのなら別れると言われてしまった"
  },
  {
    "rawStart": "00:03:07.229",
    "rawEnd": "00:03:07.239",
    "text": "らしい不倫相手に続行だった元嫁は不倫"
  },
  {
    "rawStart": "00:03:10.390",
    "rawEnd": "00:03:10.400",
    "text": "関係のままでいいから捨てないでくれと"
  },
  {
    "rawStart": "00:03:13.550",
    "rawEnd": "00:03:13.560",
    "text": "必死に頼み込んだらしいのだがお金がない"
  },
  {
    "rawStart": "00:03:16.229",
    "rawEnd": "00:03:16.239",
    "text": "お前に興味がないとあっさり捨てられて"
  },
  {
    "rawStart": "00:03:19.949",
    "rawEnd": "00:03:19.959",
    "text": "しまったらしいそれ以来精神的ショックを"
  },
  {
    "rawStart": "00:03:23.750",
    "rawEnd": "00:03:23.760",
    "text": "受けた元嫁は狭い美実家で食事も6に取ら"
  },
  {
    "rawStart": "00:03:26.830",
    "rawEnd": "00:03:26.840",
    "text": "ず引きこもっているようだったその話を"
  },
  {
    "rawStart": "00:03:31.830",
    "rawEnd": "00:03:31.840",
    "text": "聞いた時正直ざまあみろと思った俺を散々"
  },
  {
    "rawStart": "00:03:35.309",
    "rawEnd": "00:03:35.319",
    "text": "コケにしてきたバツだと思ったけどその"
  },
  {
    "rawStart": "00:03:39.949",
    "rawEnd": "00:03:39.959",
    "text": "電話はその報告だけではなく元木から友達"
  },
  {
    "rawStart": "00:03:43.789",
    "rawEnd": "00:03:43.799",
    "text": "として元嫁を助けてあげてとヘルプの電話"
  },
  {
    "rawStart": "00:03:46.869",
    "rawEnd": "00:03:46.879",
    "text": "だったようだ正直こいつらいかバカなん"
  },
  {
    "rawStart": "00:03:50.830",
    "rawEnd": "00:03:50.840",
    "text": "じゃないかと思ったけどまあ正直断る理由"
  },
  {
    "rawStart": "00:03:53.990",
    "rawEnd": "00:03:54.000",
    "text": "もなかったし俺にはある考えが浮かんでい"
  },
  {
    "rawStart": "00:03:57.030",
    "rawEnd": "00:03:57.040",
    "text": "たのでその日から元擬実家に行くように"
  },
  {
    "rawStart": "00:04:00.509",
    "rawEnd": "00:04:00.519",
    "text": "なった俺も本当お人吉だよなとか言い"
  },
  {
    "rawStart": "00:04:04.630",
    "rawEnd": "00:04:04.640",
    "text": "ながら元嫁の実家に着いたら両親は笑顔で"
  },
  {
    "rawStart": "00:04:08.190",
    "rawEnd": "00:04:08.200",
    "text": "迎え入れてくれた元嫁の部屋の前まで行く"
  },
  {
    "rawStart": "00:04:12.830",
    "rawEnd": "00:04:12.840",
    "text": "と俺は元嫁の部屋に呼びかけた何の返事も"
  },
  {
    "rawStart": "00:04:16.710",
    "rawEnd": "00:04:16.720",
    "text": "なかったけど確かに人のいる気配はする元"
  },
  {
    "rawStart": "00:04:19.509",
    "rawEnd": "00:04:19.519",
    "text": "嫁の鉱物だったデパチカの中華とか"
  },
  {
    "rawStart": "00:04:22.430",
    "rawEnd": "00:04:22.440",
    "text": "デザートとかを買ってきていたので部屋の"
  },
  {
    "rawStart": "00:04:26.150",
    "rawEnd": "00:04:26.160",
    "text": "前に置いたしばらく飯食ってないんだろう"
  },
  {
    "rawStart": "00:04:29.990",
    "rawEnd": "00:04:30.000",
    "text": "腹減ったら食えよと言ってそのの日は"
  },
  {
    "rawStart": "00:04:33.710",
    "rawEnd": "00:04:33.720",
    "text": "さっさと帰ったその次の日にはメモが置い"
  },
  {
    "rawStart": "00:04:37.990",
    "rawEnd": "00:04:38.000",
    "text": "てありありがとうとだけ書かれていたなん"
  },
  {
    "rawStart": "00:04:42.590",
    "rawEnd": "00:04:42.600",
    "text": "だ飯食えるじゃんとか思いながらその日も"
  },
  {
    "rawStart": "00:04:46.510",
    "rawEnd": "00:04:46.520",
    "text": "元嫁を呼びかけ続けたその日も元嫁は出て"
  },
  {
    "rawStart": "00:04:50.590",
    "rawEnd": "00:04:50.600",
    "text": "こなかった通い出して3日目くらいの頃"
  },
  {
    "rawStart": "00:04:53.830",
    "rawEnd": "00:04:53.840",
    "text": "夕方くらいになって気まずそうにやっと元"
  },
  {
    "rawStart": "00:04:57.749",
    "rawEnd": "00:04:57.759",
    "text": "嫁が顔を出すようになったどうやら前日に"
  },
  {
    "rawStart": "00:05:01.150",
    "rawEnd": "00:05:01.160",
    "text": "元嫁のお母さんから直接話すくらいし"
  },
  {
    "rawStart": "00:05:04.909",
    "rawEnd": "00:05:04.919",
    "text": "なさいよっって言われたらしいおずおずと"
  },
  {
    "rawStart": "00:05:09.150",
    "rawEnd": "00:05:09.160",
    "text": "出てきてはいつもありがとうと言ってきた"
  },
  {
    "rawStart": "00:05:12.230",
    "rawEnd": "00:05:12.240",
    "text": "俺は持っているパンを差し出すとさすがに"
  },
  {
    "rawStart": "00:05:15.350",
    "rawEnd": "00:05:15.360",
    "text": "お腹空いたのだろう俺の持っているパンに"
  },
  {
    "rawStart": "00:05:18.270",
    "rawEnd": "00:05:18.280",
    "text": "かぶりついていたパンを3つくらい食べる"
  },
  {
    "rawStart": "00:05:21.670",
    "rawEnd": "00:05:21.680",
    "text": "とまた部屋に戻ってしまったそれから通い"
  },
  {
    "rawStart": "00:05:24.870",
    "rawEnd": "00:05:24.880",
    "text": "出していつかもしたら慣れてきたのか同じ"
  },
  {
    "rawStart": "00:05:27.830",
    "rawEnd": "00:05:27.840",
    "text": "食卓で食事を取るようになったずっと"
  },
  {
    "rawStart": "00:05:31.150",
    "rawEnd": "00:05:31.160",
    "text": "ブスっとした顔で食事を取っていたけれど"
  },
  {
    "rawStart": "00:05:33.950",
    "rawEnd": "00:05:33.960",
    "text": "日もしたら俺の冗談に笑うようになる"
  },
  {
    "rawStart": "00:05:37.749",
    "rawEnd": "00:05:37.759",
    "text": "くらいまで回復した元嫁は元々明るい人"
  },
  {
    "rawStart": "00:05:40.830",
    "rawEnd": "00:05:40.840",
    "text": "だったし元の明るさを徐々に取り戻して"
  },
  {
    "rawStart": "00:05:44.390",
    "rawEnd": "00:05:44.400",
    "text": "いったのだと思う明るさを取り戻しても俺"
  },
  {
    "rawStart": "00:05:49.070",
    "rawEnd": "00:05:49.080",
    "text": "は週にに3回は定期的に通って元嫁家族と"
  },
  {
    "rawStart": "00:05:52.950",
    "rawEnd": "00:05:52.960",
    "text": "食事をして雑談して帰る生活を続けていた"
  },
  {
    "rawStart": "00:05:56.029",
    "rawEnd": "00:05:56.039",
    "text": "その頃になると元嫁はだんだん付き合った"
  },
  {
    "rawStart": "00:05:58.670",
    "rawEnd": "00:05:58.680",
    "text": "ばかりのような視線を俺に向けるように"
  },
  {
    "rawStart": "00:06:01.270",
    "rawEnd": "00:06:01.280",
    "text": "なったどうしてあなたにあんなことし"
  },
  {
    "rawStart": "00:06:03.990",
    "rawEnd": "00:06:04.000",
    "text": "ちゃったんだろうあなたを裏切るんじゃ"
  },
  {
    "rawStart": "00:06:07.589",
    "rawEnd": "00:06:07.599",
    "text": "なかったと泣き出すこともあった俺はその"
  },
  {
    "rawStart": "00:06:11.790",
    "rawEnd": "00:06:11.800",
    "text": "旅に背中をさすっていたすると元嫁からは"
  },
  {
    "rawStart": "00:06:15.430",
    "rawEnd": "00:06:15.440",
    "text": "体の関係を迫られたけど俺はずっと拒否し"
  },
  {
    "rawStart": "00:06:19.950",
    "rawEnd": "00:06:19.960",
    "text": "続けた元嫁からはお願いあなたしかいない"
  },
  {
    "rawStart": "00:06:24.070",
    "rawEnd": "00:06:24.080",
    "text": "のとかなんとか言われたけど絶対に体の"
  },
  {
    "rawStart": "00:06:27.670",
    "rawEnd": "00:06:27.680",
    "text": "関係を持たなかったそして今日またいつも"
  },
  {
    "rawStart": "00:06:31.270",
    "rawEnd": "00:06:31.280",
    "text": "のように美実に行ったみんなわざわざ玄関"
  },
  {
    "rawStart": "00:06:34.390",
    "rawEnd": "00:06:34.400",
    "text": "まで出迎えてくれたニコニコとした顔で"
  },
  {
    "rawStart": "00:06:38.430",
    "rawEnd": "00:06:38.440",
    "text": "出迎えてくれる元嫁と元嫁いかさあって"
  },
  {
    "rawStart": "00:06:42.029",
    "rawEnd": "00:06:42.039",
    "text": "上がってと俺を家に入れようとしてきたが"
  },
  {
    "rawStart": "00:06:45.390",
    "rawEnd": "00:06:45.400",
    "text": "それを一度制して今日は報告があってき"
  },
  {
    "rawStart": "00:06:50.710",
    "rawEnd": "00:06:50.720",
    "text": "ました玄関から上がらずに行ったえ何と顔"
  },
  {
    "rawStart": "00:06:54.430",
    "rawEnd": "00:06:54.440",
    "text": "を見合わせる元嫁と元嫁家族を見回した後"
  },
  {
    "rawStart": "00:06:58.710",
    "rawEnd": "00:06:58.720",
    "text": "少し声を張って実は他の女性と入籍しまし"
  },
  {
    "rawStart": "00:07:03.830",
    "rawEnd": "00:07:03.840",
    "text": "たと告げた入籍したのは本当についさっき"
  },
  {
    "rawStart": "00:07:07.749",
    "rawEnd": "00:07:07.759",
    "text": "のことで元嫁と別れてから職場で出会い俺"
  },
  {
    "rawStart": "00:07:10.110",
    "rawEnd": "00:07:10.120",
    "text": "のことを常に気にかけてくれる人で"
  },
  {
    "rawStart": "00:07:13.629",
    "rawEnd": "00:07:13.639",
    "text": "とっても素敵な人だ車にも原嫁を載せて"
  },
  {
    "rawStart": "00:07:16.749",
    "rawEnd": "00:07:16.759",
    "text": "いるので長いはできないから報告だけしに"
  },
  {
    "rawStart": "00:07:20.869",
    "rawEnd": "00:07:20.879",
    "text": "来たという胸を伝え元嫁はもうすっかり"
  },
  {
    "rawStart": "00:07:24.469",
    "rawEnd": "00:07:24.479",
    "text": "元気で大丈夫そうだし新しい嫁にも悪いの"
  },
  {
    "rawStart": "00:07:27.869",
    "rawEnd": "00:07:27.879",
    "text": "でもうここに来るのはやにするよじゃあね"
  },
  {
    "rawStart": "00:07:32.309",
    "rawEnd": "00:07:32.319",
    "text": "と笑顔で言って帰ってきてやった俺は元嫁"
  },
  {
    "rawStart": "00:07:35.350",
    "rawEnd": "00:07:35.360",
    "text": "と結婚していた頃元嫁のことがもちろん"
  },
  {
    "rawStart": "00:07:39.350",
    "rawEnd": "00:07:39.360",
    "text": "何よりも大切だっただから元嫁には"
  },
  {
    "rawStart": "00:07:41.990",
    "rawEnd": "00:07:42.000",
    "text": "ちゃんとお金に不自由させないように"
  },
  {
    "rawStart": "00:07:45.510",
    "rawEnd": "00:07:45.520",
    "text": "頑張って頑張って働いていたそんな俺を"
  },
  {
    "rawStart": "00:07:49.510",
    "rawEnd": "00:07:49.520",
    "text": "はっきりつまらない男と吐き捨ててその"
  },
  {
    "rawStart": "00:07:52.469",
    "rawEnd": "00:07:52.479",
    "text": "頑張って稼いだ俺の金でほぼ無職のバンド"
  },
  {
    "rawStart": "00:07:55.869",
    "rawEnd": "00:07:55.879",
    "text": "マンに貢いでいた元嫁も毎月5万も"
  },
  {
    "rawStart": "00:07:58.950",
    "rawEnd": "00:07:58.960",
    "text": "しっかり仕送りしていたのに解消がなかっ"
  },
  {
    "rawStart": "00:08:02.430",
    "rawEnd": "00:08:02.440",
    "text": "たかから浮されるんだと謎に上から目線で"
  },
  {
    "rawStart": "00:08:05.670",
    "rawEnd": "00:08:05.680",
    "text": "説教してきた元嫁一家も殺してやりたい"
  },
  {
    "rawStart": "00:08:09.550",
    "rawEnd": "00:08:09.560",
    "text": "くらい憎かったんだだから元嫁をどうにか"
  },
  {
    "rawStart": "00:08:12.230",
    "rawEnd": "00:08:12.240",
    "text": "して欲しいということを言われた時には"
  },
  {
    "rawStart": "00:08:16.110",
    "rawEnd": "00:08:16.120",
    "text": "これはチャンスだと思った定期的に通い元"
  },
  {
    "rawStart": "00:08:19.309",
    "rawEnd": "00:08:19.319",
    "text": "嫁を元気づけた俺をニコニコと迎え入れ"
  },
  {
    "rawStart": "00:08:23.550",
    "rawEnd": "00:08:23.560",
    "text": "恋心まで芽生えさせた元嫁と俺の復縁は"
  },
  {
    "rawStart": "00:08:26.950",
    "rawEnd": "00:08:26.960",
    "text": "時間の問題だと思っていたであろう元嫁と"
  },
  {
    "rawStart": "00:08:30.710",
    "rawEnd": "00:08:30.720",
    "text": "元嫁一家の絶望した顔を見た時正直に"
  },
  {
    "rawStart": "00:08:33.750",
    "rawEnd": "00:08:33.760",
    "text": "申し上げてめちゃくちゃに気持ちよかった"
  },
  {
    "rawStart": "00:08:36.949",
    "rawEnd": "00:08:36.959",
    "text": "せっかく外に出てきた元嫁がまたこもって"
  },
  {
    "rawStart": "00:08:40.269",
    "rawEnd": "00:08:40.279",
    "text": "しまうんだろうかなんて思うと笑って"
  },
  {
    "rawStart": "00:08:43.790",
    "rawEnd": "00:08:43.800",
    "text": "しまうそこまで憎んでいた元嫁一家の言う"
  },
  {
    "rawStart": "00:08:47.470",
    "rawEnd": "00:08:47.480",
    "text": "ことに数ヶ月とはいえ頑張って従っていた"
  },
  {
    "rawStart": "00:08:51.030",
    "rawEnd": "00:08:51.040",
    "text": "自分を本当に褒めてあげたいと思う絶望し"
  },
  {
    "rawStart": "00:08:54.430",
    "rawEnd": "00:08:54.440",
    "text": "た顔を見られて満足したしうちの両親は"
  },
  {
    "rawStart": "00:08:58.269",
    "rawEnd": "00:08:58.279",
    "text": "早くに多していたこともあり実家も特の昔"
  },
  {
    "rawStart": "00:08:59.750",
    "rawEnd": "00:08:59.760",
    "text": "に処分したし"
  },
  {
    "rawStart": "00:09:02.790",
    "rawEnd": "00:09:02.800",
    "text": "こっちを特定することもできないと思う"
  },
  {
    "rawStart": "00:09:05.630",
    "rawEnd": "00:09:05.640",
    "text": "電話番号やメールアドレスといった連絡先"
  },
  {
    "rawStart": "00:09:09.069",
    "rawEnd": "00:09:09.079",
    "text": "も全部変えてやったこれで連絡が来ること"
  },
  {
    "rawStart": "00:09:12.949",
    "rawEnd": "00:09:12.959",
    "text": "もないだろうなので結婚と同時に立てた"
  },
  {
    "rawStart": "00:09:17.310",
    "rawEnd": "00:09:17.320",
    "text": "新しい家で大切な嫁と新婚生活楽しみます"
  },
  {
    "rawStart": "00:09:21.389",
    "rawEnd": "00:09:21.399",
    "text": "まこの話は復讐とまではかないかもしれ"
  },
  {
    "rawStart": "00:09:24.269",
    "rawEnd": "00:09:24.279",
    "text": "ないけれど自分的にはすっきりしたので"
  },
  {
    "rawStart": "00:09:28.430",
    "rawEnd": "00:09:28.440",
    "text": "よしとするこんな話は誰にも言えないけど"
  },
  {
    "rawStart": "00:09:31.110",
    "rawEnd": "00:09:31.120",
    "text": "誰かに聞いて欲しかったからここに書いて"
  },
  {
    "rawStart": "00:09:34.710",
    "rawEnd": "00:09:34.720",
    "text": "みましたおかげでもっとすっきりしました"
  },
  {
    "rawStart": "00:09:37.990",
    "rawEnd": "00:09:38.000",
    "text": "そうそうなんで今日という日に結婚報告を"
  },
  {
    "rawStart": "00:09:41.190",
    "rawEnd": "00:09:41.200",
    "text": "したかと言うと今日は元嫁の誕生日だった"
  },
  {
    "rawStart": "00:09:44.790",
    "rawEnd": "00:09:44.800",
    "text": "から家に誘われたのもささやかだけど"
  },
  {
    "rawStart": "00:09:47.630",
    "rawEnd": "00:09:47.640",
    "text": "パーティーをしようって言われてたからだ"
  },
  {
    "rawStart": "00:09:51.310",
    "rawEnd": "00:09:51.320",
    "text": "から今日最後の爆弾を落としたというわけ"
  },
  {
    "rawStart": "00:09:55.590",
    "rawEnd": "00:09:55.600",
    "text": "絶望した顔を見るには最高の日でしょいや"
  },
  {
    "rawStart": "00:09:58.110",
    "rawEnd": "00:09:58.120",
    "text": "本当に最高でした"
  },
  {
    "rawStart": "00:10:02.079",
    "rawEnd": "00:10:06.230",
    "text": "ご視聴いただきありがとうございまし"
  },
  {
    "rawStart": "00:10:10.190",
    "rawEnd": "00:10:10.200",
    "text": "た次回作も頑張りますのでまたご覧"
  },
  {
    "rawStart": "00:10:13.870",
    "rawEnd": "00:10:13.880",
    "text": "いただけますと幸いでござい"
  },
  {
    "rawStart": "00:10:17.430",
    "rawEnd": "00:10:17.440",
    "text": "ますチャンネル登録いいねもよろしくお"
  }
]